{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Wraps OpenNext's `.open-next/worker.js` to let Workers Cache share the
  // catalog and product pages (see worker.ts).
  "main": "worker.ts",
  "name": "9k-store",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // Self-reference service binding, the service name must match the worker name
      // see https://opennext.js.org/cloudflare/caching
      "binding": "WORKER_SELF_REFERENCE",
      "service": "9k-store",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "9k-store",
      "database_id": "fc687a80-2cde-46f3-865a-78a051f6cd3b",
      "migrations_dir": "migrations",
    },
  ],
  // The product photos bucket and the Images processor are bound here. `cache` is Workers Cache: it serves
  // the photo variants and the catalog and product pages (worker.ts), and every other page opts out through
  // Next's own `Cache-Control`. The cache stays per version (no `cross_version_cache`): a cached page links
  // to the `/_next/static` files of the version that rendered it, which the next deploy no longer serves.
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "9k-store-photos" }],
  "images": { "binding": "IMAGES" },
  "cache": { "enabled": true },
  "env": {
    // Deployed from `develop` by Workers Builds. Bindings are not inherited,
    // so every binding added above needs a staging copy here.
    "staging": {
      "name": "9k-store-staging",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "9k-store-staging",
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "9k-store-staging",
          "database_id": "324653e8-88de-4a01-a499-a9b463816a79",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "9k-store-photos-staging" }],
      "images": { "binding": "IMAGES" },
      "cache": { "enabled": true },
      // The store must fit Cloudflare's free plan, which allows 10 ms of CPU
      // per request. The account is on Workers Paid, so staging enforces the
      // free limit itself; a request over it fails with error 1102.
      "limits": { "cpu_ms": 10 },
      // Workers Logs, where each request's CPU time is recorded.
      "observability": { "enabled": true },
      // Branch Previews (`wrangler preview --env staging`) run under the
      // staging Worker. Bindings are not inherited here either; preview
      // bindings go in this block. WORKER_SELF_REFERENCE is left out because
      // a Preview's service binding resolves to the deployed staging Worker,
      // not to the Preview itself.
      "previews": {
        "d1_databases": [
          {
            "binding": "DB",
            "database_name": "9k-store-staging",
            "database_id": "324653e8-88de-4a01-a499-a9b463816a79",
            "migrations_dir": "migrations",
          },
        ],
        "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "9k-store-photos-staging" }],
        "images": { "binding": "IMAGES" },
        "cache": { "enabled": true },
      },
    },
  },
}
