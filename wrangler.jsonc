{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "9k-store",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      // Self-reference service binding, the service name must match the worker name
      // see https://opennext.js.org/cloudflare/caching
      "binding": "WORKER_SELF_REFERENCE",
      "service": "9k-store",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "9k-store",
      "database_id": "fc687a80-2cde-46f3-865a-78a051f6cd3b",
      "migrations_dir": "migrations",
    },
  ],
  // The product photos bucket and the Images processor are bound here; `cache` is Workers Cache for the photo variants (pages opt out through Next's own `Cache-Control`).
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "9k-store-photos" }],
  "images": { "binding": "IMAGES" },
  "cache": { "enabled": true, "cross_version_cache": true },
  "env": {
    // Deployed from `develop` by Workers Builds. Bindings are not inherited,
    // so every binding added above needs a staging copy here.
    "staging": {
      "name": "9k-store-staging",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "9k-store-staging",
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "9k-store-staging",
          "database_id": "324653e8-88de-4a01-a499-a9b463816a79",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "9k-store-photos-staging" }],
      "images": { "binding": "IMAGES" },
      "cache": { "enabled": true, "cross_version_cache": true },
      // Branch Previews (`wrangler preview --env staging`) run under the
      // staging Worker. Bindings are not inherited here either; preview
      // bindings go in this block. WORKER_SELF_REFERENCE is left out because
      // a Preview's service binding resolves to the deployed staging Worker,
      // not to the Preview itself.
      "previews": {
        "d1_databases": [
          {
            "binding": "DB",
            "database_name": "9k-store-staging",
            "database_id": "324653e8-88de-4a01-a499-a9b463816a79",
            "migrations_dir": "migrations",
          },
        ],
        "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "9k-store-photos-staging" }],
        "images": { "binding": "IMAGES" },
        "cache": { "enabled": true, "cross_version_cache": true },
      },
    },
  },
}
