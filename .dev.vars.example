NEXTJS_ENV=development
# The password the owner types on /admin/login. At least 12 characters;
# a shorter one leaves the admin "not set up".
ADMIN_PASSWORD=change-me
# Signs the owner's login cookie. Generate one with: openssl rand -base64 32
SESSION_SECRET=replace-me
# The site's public origin for link-preview tags and the WhatsApp message's
# link. Production sets it to https://store.9k.school in wrangler.jsonc's
# top-level "vars", which `pnpm dev` and `pnpm preview` also read. Keep it
# empty here so local runs use the request's origin instead.
PUBLIC_ORIGIN=
